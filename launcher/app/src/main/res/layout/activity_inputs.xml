<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent host for the input picker, started by MiRemoteKeyService when the Xiaomi remote's
     TV key is pressed in an app. The panel is the same glass list the Inputs pill shows. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="96dp"
        android:minWidth="320dp"
        android:orientation="vertical"
        android:background="@drawable/glass_panel"
        android:padding="6dp"
        android:elevation="12dp">

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
